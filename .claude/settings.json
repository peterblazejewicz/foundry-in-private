{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "outputStyle": "terse",
  "env": {
    "AZURE_MCP_COLLECT_TELEMETRY": "false"
  },
  "extraKnownMarketplaces": {
    "foundry-in-private": {
      "source": {
        "source": "directory",
        "path": "./"
      }
    }
  },
  "enabledPlugins": {
    "cell-azure@foundry-in-private": true
  },
  "permissions": {
    "allow": [
      "Bash(uv sync *)",
      "Bash(uv run ruff *)",
      "Bash(uv run pyright*)",
      "Bash(uv run pytest*)",
      "Bash(uv run pre-commit run *)",
      "Bash(dotnet restore *)",
      "Bash(dotnet build *)",
      "Bash(dotnet test *)",
      "Bash(dotnet format *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)",
      "Bash(git switch -c *)",
      "mcp__azure-cost__list_budgets",
      "mcp__azure-cost__list_alerts",
      "mcp__azure-cost__list_dimensions",
      "mcp__azure-cost__list_benefit_utilization",
      "mcp__azure-cost__list_reservation_transactions",
      "mcp__azure-cost__list_resource_and_action_types",
      "mcp__azure-cost__get_budget",
      "mcp__azure-cost__get_retail_prices",
      "mcp__azure-cost__get_resource",
      "mcp__azure-cost__get_resource_type_schema",
      "mcp__azure-cost__get_resource_action_schema",
      "mcp__azure-cost__get_async_operation_status",
      "mcp__azure-cost__get_deployment_status",
      "mcp__azure-cost__get_pricesheet_status",
      "mcp__azure-cost__get_benefit_recommendations",
      "mcp__azure-cost__query_costs",
      "mcp__azure-cost__query_aks_costs",
      "mcp__azure-cost__forecast_costs",
      "mcp__azure-cost__validate_query",
      "mcp__azure-cost__generate_query"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(gh pr create *)",
      "Bash(azd up*)",
      "Bash(azd provision*)",
      "Bash(azd deploy*)",
      "Bash(azd down*)",
      "Bash(az deployment *)",
      "Bash(az group *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(rsync *)",
      "mcp__plugin_cell-azure_azure__*",
      "mcp__azure-cost__create_budget",
      "mcp__azure-cost__create_deployment",
      "mcp__azure-cost__create_or_update_resource",
      "mcp__azure-cost__create_or_update_resource_group",
      "mcp__azure-cost__execute_resource_action",
      "mcp__azure-cost__cancel_deployment",
      "mcp__azure-cost__start_pricesheet_download",
      "mcp__azure-cost__whatif_deployment",
      "mcp__azure-cost__execute_query"
    ],
    "deny": [
      "Bash(git push origin main*)",
      "Bash(git push * main)",
      "Bash(git push * main:*)",
      "Bash(git push * HEAD:main*)",
      "Bash(git push * refs/heads/main*)",
      "Bash(git push --force*)",
      "Bash(git push * --force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git push * --no-verify*)",
      "Bash(git commit * --no-verify*)",
      "Bash(git reset --hard*)",
      "Bash(gh pr merge *)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./.azure/**)"
    ]
  }
}

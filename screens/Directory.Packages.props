<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!-- Avalonia 12.1.4 is the version proven on the VENTUNO Q DRM/evdi path (AskBox kiosk). Move it on purpose. -->
  <ItemGroup Label="Avalonia (DRM thin clients)">
    <PackageVersion Include="Avalonia" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageVersion Include="Avalonia.LinuxFramebuffer" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.4" />
  </ItemGroup>

  <!-- Contract model generator (screens/tools/ContractGen). Tool only: Screen.Core does not reference it. -->
  <ItemGroup Label="Contract generator">
    <PackageVersion Include="NJsonSchema.CodeGeneration.CSharp" Version="11.6.2" />
  </ItemGroup>

  <ItemGroup Label="Tests">
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
  </ItemGroup>
</Project>
